{
  "manifest_version": 3,
  "name": "FA Vision Autopilot",
  "version": "5.4.0",
  "description": "Works with your FA Vision admin: renews Facebook Marketplace listings, posts into Facebook groups on Instagram, X, TikTok and YouTube, and syncs prices. Updates itself from your website. Keeps running when the browser is minimised or the screen is locked. Click the icon for the FA Vision Agent (does tasks in your browser, searches the web) and a searchable automation-script library.",
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_icon": "icon128.png",
    "default_title": "FA Vision Agent and scripts"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "scripting",
    "userScripts",
    "power",
    "sidePanel",
    "activeTab"
  ],
  "host_permissions": [
    "https://favisionenterprize.github.io/*",
    "https://*.facebook.com/*",
    "https://www.instagram.com/*",
    "https://www.tiktok.com/*",
    "https://x.com/*",
    "https://www.youtube.com/*",
    "https://studio.youtube.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://ads.tiktok.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://favisionenterprize.github.io/admin/*"
      ],
      "js": [
        "admin.js"
      ],
      "run_at": "document_start"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
