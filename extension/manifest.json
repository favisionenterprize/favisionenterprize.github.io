{
  "manifest_version": 3,
  "name": "FA Vision Autopilot",
  "version": "5.1.0",
  "description": "Works with your FA Vision admin: renews Facebook Marketplace listings, posts into Facebook groups on Instagram, X, TikTok and YouTube, and syncs prices. Updates itself from your website.",
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_icon": "icon128.png",
    "default_title": "FA Vision autopilot"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "scripting",
    "userScripts"
  ],
  "host_permissions": [
    "https://favisionenterprize.github.io/*",
    "https://*.facebook.com/*",
    "https://www.instagram.com/*",
    "https://www.tiktok.com/*",
    "https://x.com/*",
    "https://www.youtube.com/*",
    "https://studio.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://favisionenterprize.github.io/admin/*"
      ],
      "js": [
        "admin.js"
      ],
      "run_at": "document_start"
    }
  ]
}
